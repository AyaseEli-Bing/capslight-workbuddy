#!/bin/bash
# caps-indicator — WorkBuddy status states on the Caps Lock LED.
#
#   caps-indicator working   slow blink (WorkBuddy is thinking / running tools)
#   caps-indicator waiting   fast blink (it needs you: permission prompt, question)
#   caps-indicator done      solid on (turn finished)
#   caps-indicator notify    for the Notification hook — WorkBuddy uses Notification for
#                            both "it needs you" and "the turn is over", so the state is
#                            resolved from the payload's notification_type
#   caps-indicator off       dark (conversation closed)
#   caps-indicator reset     kill everything and turn the LED off
#
#   caps-indicator disable   mute the indicator (hooks stay wired, they just do nothing)
#   caps-indicator enable    unmute it
#   caps-indicator status    report muted/active and the current state
#
# Called from WorkBuddy hooks. Concurrent conversations are handled: each session's state
# is tracked separately and the highest-priority one wins the LED
# (waiting > working > done > off).
#
# Set CAPSLIGHT_DISABLED=1 in the environment to mute a single session without
# touching the global switch.

set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CAPSLED="$SELF_DIR/capsled"

# WorkBuddy keeps its config under ~/.workbuddy. WORKBUDDY_CONFIG_DIR moves the whole
# tree, and the agent runtime honours it — so the state has to follow it too.
WORKBUDDY_DIR="${WORKBUDDY_CONFIG_DIR:-$HOME/.workbuddy}"
STATE_DIR="${CAPS_INDICATOR_HOME:-$WORKBUDDY_DIR/capsled}"
SESS_DIR="$STATE_DIR/sessions"
PIDFILE="$STATE_DIR/blink.pid"
CURFILE="$STATE_DIR/current"
LOCKDIR="$STATE_DIR/lock"
MUTEFILE="$STATE_DIR/disabled"

# Blink shape: cycle length and the fraction of it the LED stays lit.
WORKING_INTERVAL="${CAPS_WORKING_INTERVAL:-0.7}"
WORKING_DUTY="${CAPS_WORKING_DUTY:-0.35}"
WAITING_INTERVAL="${CAPS_WAITING_INTERVAL:-0.22}"
WAITING_DUTY="${CAPS_WAITING_DUTY:-0.5}"

# How long a blinker may run without anyone refreshing it, and how long a session record
# survives without a hook. Both are dead-man's switches for sessions that end abruptly:
# an active session touches its record on every hook, so neither ever fires in normal use.
BLINK_MAX_SECONDS="${CAPS_BLINK_MAX_SECONDS:-900}"
SESSION_TTL_MINUTES="${CAPS_SESSION_TTL_MINUTES:-30}"

mkdir -p "$SESS_DIR"

[ -x "$CAPSLED" ] || { echo "caps-indicator: $CAPSLED not found" >&2; exit 1; }

# --- helpers -----------------------------------------------------------------

priority() {
  case "$1" in
    waiting) echo 3 ;;
    working) echo 2 ;;
    done)    echo 1 ;;
    *)       echo 0 ;;
  esac
}

# Crude lock so concurrent hooks don't fight over the LED.
acquire_lock() {
  local tries=0
  while ! mkdir "$LOCKDIR" 2>/dev/null; do
    # clear a stale lock (older than ~10 seconds)
    if [ -n "$(find "$LOCKDIR" -maxdepth 0 -mmin +0.17 2>/dev/null)" ]; then
      rmdir "$LOCKDIR" 2>/dev/null
    fi
    tries=$((tries + 1))
    [ "$tries" -gt 50 ] && return 0
    sleep 0.02
  done
  trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT
}

blinker_alive() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

stop_blinker() {
  if [ -f "$PIDFILE" ]; then
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null
      # give it a moment to turn the LED off on its way out
      local i=0
      while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
        sleep 0.02
        i=$((i + 1))
      done
      kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    fi
    rm -f "$PIDFILE"
  fi

  # Sweep up any blinker the pid file doesn't know about. One can be orphaned by a crashed
  # session, a kill -9, or a pid file overwritten by a racing hook — and nothing else would
  # ever reap it, so the LED keeps blinking with no session behind it.
  pkill -f "$(basename "$CAPSLED") blink" 2>/dev/null || true
}

start_blinker() {
  local interval="$1" duty="$2"
  nohup "$CAPSLED" blink "$interval" "$duty" "$BLINK_MAX_SECONDS" >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
  disown 2>/dev/null || true
}

apply() {
  local state="$1"
  # Already in this state — do nothing, so the blink doesn't restart on every PostToolUse.
  # Unless the blinker died on us (its own dead-man's switch, or someone killed it), in
  # which case fall through and start a fresh one.
  if [ -f "$CURFILE" ] && [ "$(cat "$CURFILE" 2>/dev/null)" = "$state" ]; then
    case "$state" in
      working|waiting) blinker_alive && return 0 ;;
      *)               return 0 ;;
    esac
  fi

  stop_blinker
  case "$state" in
    working) start_blinker "$WORKING_INTERVAL" "$WORKING_DUTY" ;;
    waiting) start_blinker "$WAITING_INTERVAL" "$WAITING_DUTY" ;;
    done)    "$CAPSLED" on  >/dev/null 2>&1 ;;
    *)       "$CAPSLED" off >/dev/null 2>&1 ;;
  esac
  echo "$state" > "$CURFILE"
}

# --- main --------------------------------------------------------------------

want="${1:-}"
[ -n "$want" ] || {
  echo "usage: caps-indicator working|waiting|done|notify|off|reset|disable|enable|status" >&2
  exit 1
}

# The mute switch, handled before anything else so it stays cheap and always works.
case "$want" in
  disable)
    acquire_lock
    : > "$MUTEFILE"
    stop_blinker
    rm -f "$CURFILE"
    "$CAPSLED" off >/dev/null 2>&1
    echo "capslight: muted — hooks stay wired but the LED stays dark"
    echo "           re-enable with: caps-indicator enable"
    exit 0
    ;;
  enable)
    rm -f "$MUTEFILE"
    echo "capslight: active again — the next hook will light it up"
    exit 0
    ;;
  status)
    if [ -f "$MUTEFILE" ]; then
      echo "muted (caps-indicator enable to turn it back on)"
    else
      echo "active, current state: $(cat "$CURFILE" 2>/dev/null || echo off)"
    fi
    exit 0
    ;;
  reset)
    # Handled here, before the payload is read: reset needs no session id, and it is the
    # command people run by hand — it must never sit waiting on stdin.
    acquire_lock
    rm -f "$SESS_DIR"/* 2>/dev/null
    rm -f "$CURFILE"
    stop_blinker
    "$CAPSLED" off >/dev/null 2>&1
    exit 0
    ;;
esac

# Muted? Do nothing. `reset` is handled above, so it still works while muted.
if [ -f "$MUTEFILE" ] || [ -n "${CAPSLIGHT_DISABLED:-}" ]; then
  exit 0
fi

# --- read the hook payload ---------------------------------------------------

# WorkBuddy writes the hook JSON to stdin and closes the pipe, **with no trailing
# newline**. A `while IFS= read -r line` loop therefore throws the whole payload away on
# the bash 3.2 that ships with macOS: the final unterminated line is read into the
# variable but the loop condition fails, so nothing gets appended.
#
# `read -d ''` reads the entire payload in one call. It still returns non-zero on the
# unterminated final line, hence the `|| true`.
#
# The timeout is for the case where the script inherits a pipe nobody ever closes (a
# wrapper script, cron, launchd) — a plain `cat` would hang there forever.
payload=""
session_id=""
if [ ! -t 0 ]; then
  IFS= read -r -t 1 -d '' payload || true
  session_id="$(printf '%s' "$payload" \
    | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | head -1)"
fi

event="$(printf '%s' "$payload" \
  | sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  | head -1)"

# Optional breadcrumb trail for working out why the LED did what it did.
if [ -n "${CAPSLIGHT_DEBUG:-}" ] || [ -f "$STATE_DIR/debug" ]; then
  printf '%s arg=%s event=%s payload=%s\n' \
    "$(date '+%H:%M:%S')" "$want" "${event:-?}" "$payload" >> "$STATE_DIR/debug.log" 2>/dev/null
fi

# WorkBuddy fires Notification for several unrelated things, and unlike the agents this
# was originally written for, the payload says which one it is:
#
#   permission_prompt, elicitation_dialog, agent_needs_input  → it needs you
#   idle_prompt, agent_completed                              → the turn is over
#
# The idle one lands immediately after Stop. Treating it as "needs you" made the LED
# start blinking fast every time a task finished and the agent went quiet — which is the
# exact bug that made this branch necessary. Only the first group deserves the attention
# blink.
#
# Keyed off hook_event_name rather than the argument, so it holds however the hook was
# wired up — including installs that map Notification straight to `waiting`.
if [ "$want" = "notify" ] || [ "$event" = "Notification" ]; then
  ntype="$(printf '%s' "$payload" \
    | sed -n 's/.*"notification_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | head -1)"
  case "$ntype" in
    permission_prompt|elicitation_dialog|agent_needs_input)
      want="waiting" ;;
    idle_prompt|agent_completed)
      want="done" ;;
    "")
      # No notification_type at all — an older build, or a different agent writing the
      # same hook. Fall back to reading the free-text message.
      #
      # Keep this list narrow. "input" is deliberately absent: the idle message reads
      # "waiting for your input", so matching on it would send the LED back to the fast
      # blink on every idle notification — the bug this whole branch exists to avoid.
      message="$(printf '%s' "$payload" \
        | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -1)"
      case "$message" in
        *permission*|*Permission*|*approve*|*Approve*|*allow*|*Allow*)
          want="waiting" ;;
        *)
          want="done" ;;
      esac
      ;;
    *)
      # A notification type this build doesn't know about (auth_success, or something a
      # future version adds). Leave the LED exactly as it is — guessing here means
      # publishing a wrong state, and every wrong guess above the current state shows up
      # as a light that lies about what the agent is doing.
      exit 0
      ;;
  esac
fi

[ -n "$session_id" ] || session_id="pid-$PPID"
# normalise, in case the id carries anything odd
session_id="$(printf '%s' "$session_id" | tr -c 'A-Za-z0-9._-' '_')"

acquire_lock

if [ "$want" = "off" ]; then
  rm -f "$SESS_DIR/$session_id"
else
  echo "$want" > "$SESS_DIR/$session_id"
fi

# drop sessions that have gone silent (WorkBuddy killed / crashed, so no SessionEnd arrived)
find "$SESS_DIR" -maxdepth 1 -type f -mmin "+$SESSION_TTL_MINUTES" -delete 2>/dev/null

# effective state = highest priority across all live sessions
effective="off"
best=0
for f in "$SESS_DIR"/*; do
  [ -f "$f" ] || continue
  s="$(cat "$f" 2>/dev/null)"
  p="$(priority "$s")"
  if [ "$p" -gt "$best" ]; then
    best="$p"
    effective="$s"
  fi
done

apply "$effective"
exit 0
